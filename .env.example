# Copy this file to .env (or set these as real environment variables).
# NEVER commit your real .env - it holds secrets. .env is gitignored.

# ---------- Email sending (Phase: automated outgoing) ----------
# Pick one: none | smtp | sendgrid
EMAIL_SENDER=none

# Keeps messages from actually being sent until you're ready.
# Set to false only after you've confirmed a working setup and accept real sending.
EMAIL_DRY_RUN=true

# --- Option A: Gmail via App Password (recommended, free) ---
# 1) Enable 2-Step Verification: myaccount.google.com/security
# 2) Create an App Password: myaccount.google.com/apppasswords
# 3) Fill in:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=you@gmail.com

# --- Option B: SendGrid (already used by the daily scraper) ---
SENDGRID_API_KEY=
SENDGRID_FROM=you@verified-domain.com

# ---------- AI (optional) ----------
# AI_PROVIDER=none | gemini
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
